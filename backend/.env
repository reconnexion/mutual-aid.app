SEMAPPS_APP_NAME="L'Entraide"
SEMAPPS_APP_DESCRIPTION="Petites annonces d'entraide entre voisins, partagées en confiance"
SEMAPPS_APP_LANG=fr

SEMAPPS_HOME_URL=http://localhost:3003/
SEMAPPS_FRONT_URL=http://localhost:4003/
SEMAPPS_PORT=3003

SEMAPPS_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/

# Triple store
SEMAPPS_SPARQL_ENDPOINT=http://localhost:3030/
SEMAPPS_JENA_USER=admin
SEMAPPS_JENA_PASSWORD=admin
SEMAPPS_MAIN_DATASET=entraide
SEMAPPS_AUTH_ACCOUNTS_DATASET_NAME=settings-entraide

# Redis (format: redis://localhost:6379/0)
SEMAPPS_REDIS_CACHE_URL=
SEMAPPS_QUEUE_SERVICE_URL=redis://localhost:6379/13
